{
  "name": "serverless-api-cdk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build":  "tsc",
    "watch":  "tsc -w",
    "synth":  "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "diff":   "cdk diff",
    "test":   "jest"
  },
  "dependencies": {
    "aws-cdk-lib":                          "^2.150.0",
    "cdk-nag":                              "^2.28.0",
    "constructs":                           "^10.0.0",
    "source-map-support":                   "^0.5.21"
  },
  "devDependencies": {
    "@types/node":                          "^20.0.0",
    "aws-cdk":                              "^2.150.0",
    "jest":                                 "^29.0.0",
    "ts-jest":                              "^29.0.0",
    "typescript":                           "~5.4.0",
    "@types/jest":                          "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots":           ["<rootDir>/test"],
    "transform":       { "^.+\\.tsx?$": "ts-jest" },
    "testRegex":       ".*\\.test\\.ts$"
  }
}